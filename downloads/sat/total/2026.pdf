			<dc:format>application/pdf</dc:format>
			<dc:title>
				<rdf:Alt>
					<rdf:li xml:lang="en-US">CBPR SAT Annual Report (Total Group)</rdf:li>
				</rdf:Alt>
			</dc:title>
			<dc:description>
				<rdf:Alt>
					<rdf:li xml:lang="x-default">This PDF is the 2026 SAT Suite of Assessments Annual Report (Total Group), presenting participation, performance, score distributions, and demographic breakdowns for the Class of 2026 SAT along with PSAT/NMSQT, PSAT 10, and PSAT 8/9 takers from the 2025-26 school year. It covers key metrics such as mean scores, benchmark attainment, intended college majors, and additional context like fee waiver use, parental education, and family income. </rdf:li>
				</rdf:Alt>
			</dc:description>
			<dc:creator>
				<rdf:Seq>
					<rdf:li>College Board, SAT Suite of Assessments</rdf:li>
				</rdf:Seq>
			</dc:creator>
			<dc:subject>
				<rdf:Bag>
					<rdf:li>SAT Suite Annual Report</rdf:li>
					<rdf:li>Class of 2026</rdf:li>
					<rdf:li>and College and Career Readiness Benchmarks.</rdf:li>
				</rdf:Bag>
			</dc:subject>
			<pdf:Producer>Adobe PDF Library 18.0</pdf:Producer>
			<pdf:Trapped>False</pdf:Trapped>
			<pdf:Keywords>SAT Suite Annual Report, Class of 2026, and College and Career Readiness Benchmarks.</pdf:Keywords>
			<pdfuaid:part>1</pdfuaid:part>
		</rdf:Description>
